#!/usr/bin/env bash
# Run all tests in Docker containers

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo -e "${GREEN}Starting E2E test suite in containers...${NC}"

# Check if docker-compose is available
if ! command -v docker-compose &> /dev/null; then
    echo -e "${RED}Error: docker-compose is not installed${NC}"
    echo "Please install docker-compose to run tests in containers"
    exit 1
fi

# Check if .env.test exists
if [ ! -f .env.test ]; then
    echo -e "${YELLOW}Warning: .env.test file not found${NC}"
    echo "Creating .env.test from .env.development..."
    cp .env.development .env.test
fi

# Parse command line arguments
RSPEC_ARGS=""
while [[ $# -gt 0 ]]; do
    case $1 in
        --coverage)
            export COVERAGE=true
            shift
            ;;
        --parallel)
            RSPEC_ARGS="$RSPEC_ARGS --format progress"
            shift
            ;;
        *)
            RSPEC_ARGS="$RSPEC_ARGS $1"
            shift
            ;;
    esac
done

# Run tests
echo -e "${GREEN}Running: docker-compose -f docker-compose.test.yml run --rm test bundle exec rspec${NC}"
docker-compose -f docker-compose.test.yml run --rm test bundle exec rspec $RSPEC_ARGS

# Capture exit code
EXIT_CODE=$?

# Cleanup
echo -e "${GREEN}Cleaning up containers...${NC}"
docker-compose -f docker-compose.test.yml down

if [ $EXIT_CODE -eq 0 ]; then
    echo -e "${GREEN}✓ All tests passed!${NC}"
else
    echo -e "${RED}✗ Tests failed with exit code $EXIT_CODE${NC}"
    echo -e "${YELLOW}Check tmp/test_results/ for screenshots and logs${NC}"
fi

exit $EXIT_CODE
