#!/usr/bin/env bash
# Run tests in watch mode for development

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo -e "${GREEN}Starting test watch mode in containers...${NC}"

# Check if docker-compose is available
if ! command -v docker-compose &> /dev/null; then
    echo -e "${RED}Error: docker-compose is not installed${NC}"
    echo "Please install docker-compose to run tests in containers"
    exit 1
fi

# Check if .env.test exists
if [ ! -f .env.test ]; then
    echo -e "${YELLOW}Warning: .env.test file not found${NC}"
    echo "Creating .env.test from .env.development..."
    cp .env.development .env.test
fi

# Check if guard gem is available
if ! grep -q "gem 'guard-rspec'" Gemfile; then
    echo -e "${YELLOW}Warning: guard-rspec gem not found in Gemfile${NC}"
    echo "Watch mode requires guard-rspec. Add it to your Gemfile:"
    echo "  gem 'guard-rspec', require: false, group: :development"
    echo ""
    echo "Falling back to manual watch mode..."
    echo "Press Ctrl+C to stop, then run again to re-run tests"
    
    while true; do
        echo -e "${GREEN}Running tests...${NC}"
        docker-compose -f docker-compose.test.yml run --rm test bundle exec rspec
        echo -e "${YELLOW}Tests complete. Press Ctrl+C to stop, or wait to run again...${NC}"
        sleep 5
    done
else
    echo -e "${GREEN}Starting Guard for automatic test re-runs...${NC}"
    echo -e "${YELLOW}Guard will watch for file changes and re-run affected tests${NC}"
    echo -e "${YELLOW}Press Ctrl+C to stop${NC}"
    
    # Run guard in the container
    docker-compose -f docker-compose.test.yml run --rm test bundle exec guard
fi

# Cleanup on exit
trap "docker-compose -f docker-compose.test.yml down" EXIT
